{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gestao-a-vista",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Necessário para o `npx wrangler preview` que o Cloudflare Workers Builds
  // executa nos branches que não são de produção (prévias de PR).
  "previews": {}
}
